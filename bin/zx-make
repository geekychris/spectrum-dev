#!/usr/bin/env bash
# Run `make` for a Spectrum project inside the toolchain container
# (z88dk + sjasmplus; see docker/Dockerfile).
#
#   bin/zx-make [-C project_dir] [make args...]
#
# The repo is mounted at /work; projects outside the repo at /project.
source "$(dirname "$0")/../scripts/lib.sh"

proj="$PWD"
if [ "${1:-}" = "-C" ]; then proj="$(cd "$2" && pwd)"; shift 2; fi
[ -f "$proj/Makefile" ] || die "no Makefile in $proj"
if ! docker image inspect "$TOOLCHAIN_IMAGE" >/dev/null 2>&1; then
  # gone (e.g. pruned): rebuild it, usually seconds from Docker's build cache
  warn "toolchain image $TOOLCHAIN_IMAGE missing – rebuilding"
  "$ZX_ROOT/scripts/build-toolchain-image.sh" >&2 || die "could not rebuild $TOOLCHAIN_IMAGE"
fi

mounts=(-v "$ZX_ROOT:/work")
case "$proj/" in
  "$ZX_ROOT"/*) cdir="/work/${proj#"$ZX_ROOT"/}" ;;
  *)            cdir="/project"; mounts+=(-v "$proj:/project") ;;
esac

# A plain build (no make arguments) goes through the shared build cache
# (scripts/buildcache.py): same sources + SDK + toolchain = the same outputs,
# copied instead of built. ZX_BUILD_CACHE=off builds every time.
py="$ZX_ROOT/.venv/bin/python"; [ -x "$py" ] || py="$(command -v python3 || true)"
cache_key=""
if [ $# -eq 0 ] && [ "${ZX_BUILD_CACHE:-}" != off ] && [ -n "$py" ]; then
  toolchain="$(docker image inspect --format '{{.Id}}' "$TOOLCHAIN_IMAGE" 2>/dev/null)"
  if cache_key="$("$py" "$ZX_ROOT/scripts/buildcache.py" restore "$proj" "$toolchain")"; then
    echo "build cache: $(basename "$proj") up to date (${cache_key:0:12})"
    exit 0
  fi
fi

tty=(); [ -t 0 ] && [ -t 1 ] && tty=(-t)
docker run --rm ${tty[@]+"${tty[@]}"} -u "$(id -u):$(id -g)" -e HOME=/tmp \
  -e ZX_SDK=/work/sdk "${mounts[@]}" -w "$cdir" "$TOOLCHAIN_IMAGE" make "$@"
rc=$?
if [ $rc -eq 0 ] && [ -n "$cache_key" ]; then
  "$py" "$ZX_ROOT/scripts/buildcache.py" store "$proj" "$cache_key" || warn "build cache: could not store $(basename "$proj")"
fi
exit $rc
